{
  "namespace": "buddynext/v1",
  "output": "docs/api/openapi.json",
  "info": {
    "title": "BuddyNext REST API",
    "description": "The public REST surface of the BuddyNext community plugin (Free), under the `buddynext/v1` namespace. This file is generated from the live route registry by `bin/gen-openapi.php`; do not hand-edit it. The hand-written narrative reference lives in `docs/website/developer-guide/` (pages 14-24). Pro adds its own `buddynext-pro/v1` namespace, which this document intentionally excludes.",
    "version": "1.1.1",
    "contact": {
      "name": "Wbcom Designs",
      "url": "https://wbcomdesigns.com"
    },
    "license": {
      "name": "GPL-2.0-or-later"
    }
  },
  "servers": [
    {
      "url": "https://example.com/wp-json/buddynext/v1",
      "description": "Replace example.com with the site host. The base path is the site's REST root plus the buddynext/v1 namespace."
    }
  ],
  "securitySchemes": {
    "cookieAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "X-WP-Nonce",
      "description": "Logged-in browser clients send the WordPress auth cookies plus an X-WP-Nonce header (nonce for the wp_rest action)."
    },
    "appPassword": {
      "type": "http",
      "scheme": "basic",
      "description": "Non-browser clients (the native app, integrations) authenticate with a WordPress Application Password over HTTP Basic."
    }
  },
