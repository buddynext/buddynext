{
  "info": {
    "title": "BuddyNext REST API (Free + Pro)",
    "description": "The complete REST surface of BuddyNext: the Free plugin under `buddynext/v1` and BuddyNext Pro under `buddynext-pro/v1` (membership, payments, AI, analytics, email, push, moderation). Generated from the live route registry by bin/gen-openapi.php; do not hand-edit. The narrative reference lives in the Developer Guide.",
    "version": "1.0.8",
    "contact": {
      "name": "Wbcom Designs",
      "url": "https://wbcomdesigns.com"
    },
    "license": {
      "name": "GPL-2.0-or-later"
    }
  },
  "servers": [
    {
      "url": "https://example.com/wp-json",
      "description": "Replace example.com with your site host. Free endpoints live under /buddynext/v1, Pro endpoints under /buddynext-pro/v1."
    }
  ],
  "securitySchemes": {
    "cookieAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "X-WP-Nonce",
      "description": "Logged-in browser clients send the WordPress auth cookies plus an X-WP-Nonce header (nonce for the wp_rest action)."
    },
    "appPassword": {
      "type": "http",
      "scheme": "basic",
      "description": "Non-browser clients (the native app, integrations) authenticate with a WordPress Application Password over HTTP Basic."
    }
  },
