{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "buddynext/post-composer",
	"title": "Post Composer",
	"icon": "edit",
	"category": "buddynext",
	"description": "Post creation box \u2014 what's on your mind.",
	"keywords": [
		"buddynext",
		"post",
		"composer",
		"create"
	],
	"textdomain": "buddynext",
	"editorScript": "buddynext-blocks-editor",
	"style": "file:../../assets/css/blocks.css",
	"supports": {
		"inserter": false,
		"color": {
			"background": true,
			"text": true
		},
		"typography": {
			"fontSize": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"placeholder": {
			"type": "string",
			"default": ""
		}
	},
	"example": {},
	"editorStyle": "file:../../assets/css/blocks.css"
}
