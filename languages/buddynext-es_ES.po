#: includes/Auth/TwoFactorLoginGuard.php:263 templates/auth/login.php:237
msgid "Verification code"
msgstr "Código de verificación"

#: includes/Auth/TwoFactorLoginGuard.php:271
msgid "Verify"
msgstr "Verificar"

#: includes/Auth/TwoFactorLoginGuard.php:275 templates/auth/login.php:271
msgid "Email me a code instead"
msgstr "Envíame un código por correo electrónico"

#: includes/Auth/TwoFactorService.php:146
