#: includes/Notifications/NotificationMessageService.php:576
#: includes/Notifications/NotificationPrefCatalogue.php:74
#: templates/parts/profile/people-panel.php:64
msgid "Connection request"
msgid_plural "Connection requests"
msgstr[0] "Verbindungsanfrage"
msgstr[1] "Verbindungsanfragen"

#: includes/Admin/Settings.php:1411
msgid "Notify users by default when they receive a connection request."
msgstr ""
"Benachrichtige Benutzer standardmäßig, wenn sie eine Verbindungsanfrage "
"erhalten."

#: includes/Admin/Settings.php:1418
msgid "Reaction on post"
msgstr "Reaktion auf Beitrag"

#: includes/Admin/Settings.php:1420
msgid "Notify users by default when someone reacts to their post."
msgstr ""
"Benachrichtige Benutzer standardmäßig, wenn jemand auf ihren Beitrag "
"reagiert."

#: includes/Admin/Settings.php:1427
msgid "Comment on post"
msgstr "Kommentar auf Beitrag"

#: includes/Admin/Settings.php:1429
msgid "Notify users by default when someone comments on their post."
msgstr ""
"Benachrichtige Benutzer standardmäßig, wenn jemand auf ihren Beitrag "
"kommentiert."

#: includes/Admin/Settings.php:1436
msgid "@mention in post or comment"
msgstr "@-Erwähnung in Beitrag oder Kommentar"

#: includes/Admin/Settings.php:1438
msgid "Notify users by default when they are mentioned."
msgstr "Benachrichtige Benutzer standardmäßig, wenn sie erwähnt werden."

#: includes/Admin/Settings.php:1445
#: includes/Notifications/NotificationMessageService.php:621
msgid "New space member"
msgstr "Neues Space-Mitglied"

#: includes/Admin/Settings.php:1447
msgid "Notify space owners by default when someone joins their space."
msgstr ""
"Benachrichtige Space-Besitzer standardmäßig, wenn jemand ihrem Space "
"beitritt."

#: includes/Admin/Settings.php:1454
msgid "Email Digest"
msgstr "E-Mail-Zusammenfassung"

#: includes/Admin/Settings.php:1460
msgid "Digest frequency"
msgstr "Häufigkeit der Zusammenfassung"

#: includes/Admin/Settings.php:1463
msgid "Disabled — no digest emails"
msgstr "Deaktiviert – keine Zusammenfassungs-E-Mails"

#: includes/Admin/Settings.php:1464 templates/notifications/prefs.php:83
msgid "Daily"
msgstr "Täglich"

#: includes/Admin/Settings.php:1465 templates/notifications/prefs.php:84
msgid "Weekly"
msgstr "Wöchentlich"

#: includes/Admin/Settings.php:1467
msgid ""
"How often BuddyNext sends a digest of unread notifications. Individual users "
"can opt out."
msgstr ""
"Wie oft BuddyNext eine Zusammenfassung ungelesener Benachrichtigungen "
"sendet. Einzelne Benutzer können sich abmelden."

#: includes/Admin/Settings.php:1474
msgid "Admin Alerts"
msgstr "Admin-Warnungen"

#: includes/Admin/Settings.php:1480
msgid "Admin alert email"
msgstr "Admin-Warnungs-E-Mail"

#: includes/Admin/Settings.php:1483
msgid ""
"Receives daily alerts when the moderation queue or pending registration "
"count is high. Defaults to WordPress admin email."
msgstr ""
"Erhält tägliche Warnungen, wenn die Moderationswarteschlange oder die Anzahl "
"der ausstehenden Registrierungen hoch ist. Standardmäßig WordPress-Admin-E-"
"Mail."

#: includes/Admin/Settings.php:1500
msgid "Sender Identity"
msgstr "Absender-Identität"

#: includes/Admin/Settings.php:1506
msgid "From name"
msgstr "Name des Absenders"

#: includes/Admin/Settings.php:1508
msgid ""
"Display name shown in the \"From:\" field of all community emails. Defaults "
"to your site name."
msgstr ""
"Anzeigename, der im Feld \"Von:\" aller Community-E-Mails angezeigt wird. "
"Standardmäßig dein Website-Name."

#: includes/Admin/Settings.php:1515
msgid "From address"
msgstr "Absenderadresse"

#: includes/Admin/Settings.php:1518
msgid ""
"Sending address for all BuddyNext system emails. Defaults to your admin "
"email; use a verified domain for best deliverability."
msgstr ""
"Sendeadresse für alle BuddyNext-System-E-Mails. Standardmäßig deine Admin-E-"
"Mail; verwende eine verifizierte Domain für beste Zustellbarkeit."

#: includes/Admin/Settings.php:1525
msgid "Reply-To address"
msgstr "Antwort-Adresse"

#: includes/Admin/Settings.php:1527
msgid ""
"Optional. If set, replies to community emails go here instead of the From "
"address. Applied to every BuddyNext email."
msgstr ""
"Optional. Falls gesetzt, gehen Antworten auf Community-E-Mails hier hin "
"statt zur Absenderadresse. Gilt für jede BuddyNext-E-Mail."

#: includes/Admin/Settings.php:1534
msgid "Email Footer"
msgstr "E-Mail-Fußzeile"

#: includes/Admin/Settings.php:1540
msgid "Footer text"
msgstr "Fußzeilentext"

#: includes/Admin/Settings.php:1541
msgid ""
"Appended to the bottom of every BuddyNext email. Plain text, plus the "
"placeholders {{site_name}}, {{site_url}}, and {{current_year}}."
msgstr ""
"Wird am Ende jeder BuddyNext-E-Mail hinzugefügt. Nur Text, plus die "
"Platzhalter {{site_name}}, {{site_url}} und {{current_year}}."

#: includes/Admin/Settings.php:1564 includes/Admin/Settings.php:2354
msgid "Registration Settings"
msgstr "Registrierungseinstellungen"

#: includes/Admin/Settings.php:1570 includes/Admin/Settings.php:2369
msgid "Registration Mode"
msgstr "Registrierungsmodus"

#: includes/Admin/Settings.php:1571 includes/Admin/Settings.php:2377
msgid "Controls who can create a new account on your community."
msgstr "Kontrolliert, wer ein neues Konto in deiner Community erstellen kann."

#: includes/Admin/Settings.php:1578 includes/Admin/Settings.php:2422
#: includes/Onboarding/SetupWizard.php:637
msgid "Require email verification"
msgstr "E-Mail-Bestätigung erforderlich"

#: includes/Admin/Settings.php:1579
