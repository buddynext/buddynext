#: blocks/bn-community-activity/block.json
msgctxt "block description"
msgid "Show recent public activity so visitors can see the community is alive."
msgstr "Affiche l’activité publique récente pour que les visiteurs voient que la communauté est vivante."

#: blocks/bn-connection-button/block.json
msgctxt "block description"
msgid "Standalone connect/disconnect button for any user."
msgstr "Bouton de connexion/déconnexion autonome pour n'importe quel utilisateur."

#: blocks/bn-follow-button/block.json
msgctxt "block description"
msgid "Standalone follow/unfollow button for any user."
msgstr "Bouton suivre/ne plus suivre autonome pour n'importe quel utilisateur."

#: blocks/bn-header-user-menu/block.json
msgctxt "block description"
msgid "Logged-in header section: notification bell, messages icon, and avatar with a profile dropdown + log out. Works as a block-based widget in any theme's header."
msgstr "Section d'en-tête connectée : cloche de notification, icône de messages et avatar avec un menu déroulant de profil + déconnexion. Fonctionne comme un widget basé sur des blocs dans l'en-tête de n'importe quel thème."

#: blocks/bn-member-card/block.json
msgctxt "block description"
msgid "Single user card with avatar, name, and follow button. Ideal for widgets and sidebars."
msgstr "Carte utilisateur unique avec avatar, nom et bouton suivre. Idéal pour les widgets et les barres latérales."

#: blocks/bn-member-directory/block.json
msgctxt "block description"
msgid "Full filterable member grid or list with search and filters."
msgstr "Grille ou liste de membres entièrement filtrable avec recherche et filtres."

#: blocks/bn-members-showcase/block.json
msgctxt "block description"
msgid "Show a few members on a landing page so visitors can see who is already here."
msgstr "Affiche quelques membres sur une page d’accueil pour que les visiteurs voient qui est déjà là."

#: blocks/bn-my-spaces/block.json
msgctxt "block description"
msgid "Lists the spaces the current user is a member of."
msgstr "Liste les Spaces dont l'utilisateur actuel est membre."

#: blocks/bn-notification-bell/block.json
msgctxt "block description"
msgid "Bell icon with unread notification count for custom header areas."
msgstr "Icône de cloche avec le nombre de notifications non lues pour les zones d'en-tête personnalisées."

#: blocks/bn-post-composer/block.json
msgctxt "block description"
msgid "Post creation box — what's on your mind."
msgstr "Boîte de création de publication — qu'as-tu en tête."

#: blocks/bn-profile-completion-bar/block.json
msgctxt "block description"
msgid "Profile completion progress bar with prompt cards for incomplete sections."
msgstr "Barre de progression de l'achèvement du profil avec des cartes d'invite pour les sections incomplètes."

#: blocks/bn-profile-fields/block.json
msgctxt "block description"
msgid "Renders a profile field group such as basic info, work experience, or education."
msgstr "Rend un groupe de champs de profil tel que les informations de base, l'expérience professionnelle ou l'éducation."

#: blocks/bn-profile-header/block.json
msgctxt "block description"
msgid "User profile header with avatar, cover photo, name, bio, social links, and follow/connect buttons."
msgstr "En-tête de profil utilisateur avec avatar, photo de couverture, nom, biographie, liens sociaux et boutons suivre/connecter."

#: blocks/bn-search-bar/block.json
msgctxt "block description"
msgid "Unified BuddyNext search input that opens grouped results."
msgstr "Entrée de recherche BuddyNext unifiée qui ouvre les résultats groupés."

#: blocks/bn-space-card/block.json
msgctxt "block description"
msgid "Single space card for featured space callouts."
msgstr "Carte Space unique pour les mises en avant de Space."

#: blocks/bn-space-directory/block.json
msgctxt "block description"
msgid "Filterable grid of community spaces, filterable by category and membership."
msgstr "Grille de Spaces communautaires filtrable, filtrable par catégorie et adhésion."

#: blocks/bn-spaces-showcase/block.json
msgctxt "block description"
msgid "Feature a few spaces on a landing page so visitors can see what there is to join."
msgstr "Met en avant quelques espaces sur une page d’accueil pour que les visiteurs voient ce qu’ils peuvent rejoindre."

#: blocks/bn-trending-hashtags/block.json
msgctxt "block description"
msgid "Displays trending hashtags as a list or tag cloud."
msgstr "Affiche les hashtags en tendance sous forme de liste ou de nuage de balises."

