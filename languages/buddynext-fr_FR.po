#: includes/Auth/SocialLogin.php:1422
msgid "Too many sign-in attempts. Please wait a minute and try again."
msgstr "Trop de tentatives de connexion. Attends une minute et réessaye."

#: includes/Auth/SocialLogin.php:1434
msgid "Sign-in failed. Please try again."
msgstr "Échec de la connexion. Réessaie."

