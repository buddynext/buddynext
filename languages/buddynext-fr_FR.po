#: templates/parts/settings-privacy-fields.php:52
#: templates/parts/settings-privacy-fields.php:56
msgid "Everyone"
msgstr "Tout le monde"

#: includes/Admin/Settings.php:1020
msgid "No one"
msgstr "Personne"

#: includes/Admin/Settings.php:1022
msgid ""
"Default privacy applied to new accounts. Members can override this in their "
"own privacy settings."
msgstr ""
"Confidentialité par défaut appliquée aux nouveaux comptes. Les membres "
"peuvent modifier cela dans leurs propres paramètres de confidentialité."

#: includes/Admin/Settings.php:1029
msgid "Directory columns"
msgstr "Colonnes du répertoire"

#: includes/Admin/Settings.php:1035
msgid "Member directory columns (desktop)"
msgstr "Colonnes du répertoire des membres (bureau)"

#: includes/Admin/Settings.php:1039
msgid ""
"How many member cards per row on desktop. A fixed value caps the row and "
"still steps down to fewer columns on tablet and mobile; Auto fits as many as "
"the width allows."
msgstr ""
"Combien de cartes de membres par ligne sur le bureau. Une valeur fixe limite "
"la ligne et passe quand même à moins de colonnes sur tablette et mobile ; "
"Auto en place autant que la largeur le permet."

