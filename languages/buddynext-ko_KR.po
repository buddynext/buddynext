msgstr "네트워크 관리자에게 변경을 요청해 주세요."

#: includes/Auth/IdTokenVerifier.php:59 includes/Auth/IdTokenVerifier.php:67
msgid "The identity token is malformed."
msgstr "신원 토큰 형식이 올바르지 않아요."

#: includes/Auth/IdTokenVerifier.php:75
msgid "The identity token uses an unsupported algorithm."
msgstr "신원 토큰이 지원하지 않는 알고리즘을 사용하고 있어요."

#: includes/Auth/IdTokenVerifier.php:81
msgid "The identity token signing key could not be resolved."
msgstr "신원 토큰의 서명 키를 확인할 수 없어요."

#: includes/Auth/IdTokenVerifier.php:86
msgid "The identity token signature is invalid."
msgstr "신원 토큰의 서명이 올바르지 않아요."

#: includes/Auth/IdTokenVerifier.php:90
msgid "The identity token was issued by the wrong party."
msgstr "신원 토큰의 발급자가 올바르지 않아요."

#: includes/Auth/IdTokenVerifier.php:97
msgid "The identity token was issued for a different application."
msgstr "신원 토큰이 다른 애플리케이션용으로 발급되었어요."

#: includes/Auth/IdTokenVerifier.php:102
msgid "The identity token has expired."
msgstr "신원 토큰이 만료되었어요."

#: includes/Auth/IdTokenVerifier.php:105
msgid "The identity token is not valid yet."
msgstr "신원 토큰이 아직 유효하지 않아요."

#: includes/Auth/MemberHold.php:82
msgid "Your account cannot use the community right now."
msgstr "현재 계정으로는 커뮤니티를 이용할 수 없어요."

#. translators: %s: site name
#: includes/Auth/RegistrationEmailListener.php:136
#, php-format
msgid "Welcome to %s"
msgstr "%s에 오신 것을 환영해요"

#. translators: 1: display name, 2: site name, 3: community URL
#: includes/Auth/RegistrationEmailListener.php:141
#, php-format
msgid ""
"Welcome aboard, %1$s! Your account at %2$s is ready. Jump in, complete your "
"profile, and start connecting with the community: %3$s"
msgstr ""
"%1$s님, 환영해요! %2$s 계정이 준비되었어요. 프로필을 완성하고 커뮤니티에서 다"
"른 멤버들과 연결해 보세요: %3$s"

#. translators: %s: site name
#: includes/Auth/RegistrationEmailListener.php:170
#, php-format
msgid "Your registration at %s is awaiting approval"
msgstr "%s 회원가입이 승인 대기 중이에요"

#. translators: 1: display name, 2: site name
#: includes/Auth/RegistrationEmailListener.php:175
#, php-format
msgid ""
"Hi %1$s, thanks for registering at %2$s. An administrator needs to review "
"your account before you can sign in: we will email you as soon as it is "
"approved."
msgstr ""
"%1$s님, %2$s에 가입해 주셔서 감사해요. 로그인하시려면 먼저 관리자가 계정을 검"
"토해야 해요. 승인되면 이메일로 알려 드릴게요."

#. translators: %s: site name
#: includes/Auth/RegistrationEmailListener.php:186
#, php-format
msgid "New registration awaiting approval: %s"
msgstr "승인 대기 중인 새 회원가입: %s"

#. translators: 1: username, 2: email, 3: review URL
#: includes/Auth/RegistrationEmailListener.php:191
#, php-format
msgid ""
"%1$s (%2$s) has registered and is awaiting your approval. Review pending "
"members here: %3$s"
msgstr ""
"%1$s(%2$s)님이 가입했으며 승인을 기다리고 있어요. 승인 대기 멤버는 여기에서 "
"확인할 수 있어요: %3$s"

#. translators: %s: site name
#: includes/Auth/RegistrationEmailListener.php:215
#, php-format
msgid "Your account at %s is approved"
msgstr "%s 계정이 승인되었어요"

#. translators: 1: display name, 2: site name, 3: sign-in URL
#: includes/Auth/RegistrationEmailListener.php:220
#, php-format
msgid ""
"Good news, %1$s: your account at %2$s has been approved. You can now sign "
"in: %3$s"
msgstr ""
"좋은 소식이에요, %1$s님! %2$s 계정이 승인되었어요. 이제 다음 주소에서 로그인"
"할 수 있어요: %3$s"

#. translators: %s: site name
#: includes/Auth/RegistrationEmailListener.php:247
#, php-format
msgid "Your registration at %s"
msgstr "%s 회원가입"

#. translators: 1: display name, 2: site name
#: includes/Auth/RegistrationEmailListener.php:252
#, php-format
msgid ""
"Hi %1$s, thank you for your interest in %2$s. Unfortunately your "
"registration was not approved at this time."
msgstr ""
"%1$s님, %2$s에 관심을 가져 주셔서 감사해요. 안타깝게도 이번 회원가입은 승인되"
"지 않았어요."

#: includes/Auth/RegistrationEmailListener.php:288
msgid "our community"
msgstr "저희 커뮤니티"

#: includes/Auth/RegistrationGuard.php:131
msgid "Sign-ups from your network are not allowed."
msgstr "현재 네트워크에서는 회원가입이 허용되지 않아요."

#: includes/Auth/RegistrationGuard.php:153
msgid ""
"Too many sign-up attempts from your network. Please wait a few minutes and "
"try again."
msgstr ""
"현재 네트워크에서 회원가입 시도가 너무 많아요. 잠시 후에 다시 시도해 주세요."

#: includes/Auth/RegistrationGuard.php:164
msgid ""
"That answer was not correct. Please solve the verification question and try "
"again."
msgstr "답이 올바르지 않아요. 확인 질문을 풀고 다시 시도해 주세요."

#: includes/Auth/RegistrationGuard.php:199
msgid ""
"Your sign-up looked automated and was blocked. If this is a mistake, please "
"try again."
msgstr ""
"자동 가입으로 판단되어 차단되었어요. 잘못된 판단이라면 다시 시도해 주세요."

#: includes/Auth/RegistrationGuard.php:278 includes/Auth/SocialLogin.php:1429
msgid "Sign-ups here need an email address from an approved domain."
msgstr "이 사이트에서는 허용된 도메인의 이메일 주소로만 가입할 수 있어요."

#: includes/Auth/RegistrationGuard.php:285
msgid "Sign-ups from that email domain are not accepted."
msgstr "해당 이메일 도메인으로는 가입할 수 없어요."

#: includes/Auth/RegistrationGuard.php:306
msgid "That email address cannot be used to sign up here."
msgstr "이 이메일 주소로는 가입할 수 없습니다."

#: includes/Auth/RegistrationGuard.php:384
msgid "Access from your network is not allowed."
msgstr "현재 네트워크에서는 접근할 수 없어요."

