#. translators: %s: site name
#: includes/Auth/VerificationListener.php:340
#, php-format
msgid "Verify your email address on %s"
msgstr "Verifica il tuo indirizzo email su %s"

#. translators: 1: display name, 2: site name, 3: verification URL
#: includes/Auth/VerificationListener.php:346
#, php-format
msgid ""
"Hi %1$s,\n"
"\n"
"Please verify your email address on %2$s by clicking the link below:\n"
"\n"
"%3$s\n"
"\n"
"This link expires in 48 hours.\n"
"\n"
"If you did not register, please ignore this email."
msgstr ""
"Ciao %1$s,\n"
"\n"
"Verifica il tuo indirizzo email su %2$s facendo clic sul link di seguito:\n"
"\n"
"%3$s\n"
"\n"
"Questo link scade tra 48 ore.\n"
"\n"
"Se non ti sei registrato, ignora questa email."

#. translators: %s: site name
#: includes/Auth/VerificationListener.php:431
#, php-format
msgid "Confirm your new email address on %s"
msgstr "Conferma il tuo nuovo indirizzo email su %s"

#. translators: 1: display name, 2: site name, 3: confirmation URL
#: includes/Auth/VerificationListener.php:437
#, php-format
msgid ""
"Hi %1$s,\n"
"\n"
"You asked to change the email address on your %2$s account to this inbox. "
"Confirm the change by clicking the link below:\n"
"\n"
"%3$s\n"
"\n"
"This link expires in 24 hours. If you did not request the change, ignore "
"this email and the address on your account stays the same."
msgstr ""
"Ciao %1$s,\n"
"\n"
"Hai chiesto di cambiare l'indirizzo email del tuo account %2$s in questa "
"inbox. Conferma la modifica facendo clic sul link di seguito:\n"
"\n"
"%3$s\n"
"\n"
"Questo link scade tra 24 ore. Se non hai richiesto la modifica, ignora "
"questa email e l'indirizzo nel tuo account rimane lo stesso."

