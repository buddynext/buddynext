#: includes/Admin/ToolsTab.php:438
#, php-format
msgid "Last attempt, %1$s: %2$s"
msgstr "Ultimo tentativo, %1$s: %2$s"

#: includes/Admin/ToolsTab.php:445
msgid "Check and repair database"
msgstr "Controlla e ripara il database"

#: includes/Admin/ToolsTab.php:449
msgid ""
"When BuddyNext improves the wording of a default email, sites update the "
"emails nobody has edited. Use this if your site skipped that step. Emails "
"you have customised are never changed."
msgstr ""
"Quando BuddyNext migliora il testo di un'email predefinita, i siti "
"aggiornano le email che nessuno ha modificato. Usalo se il tuo sito ha "
"saltato questo passaggio. Le email che hai personalizzato non vengono mai "
"modificate."

#: includes/Admin/ToolsTab.php:455
msgid "Status: every unedited email uses the latest default wording."
msgstr "Stato: ogni email non modificata usa il testo predefinito più recente."

