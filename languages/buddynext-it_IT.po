msgid "Export / Import settings"
msgstr "Esporta / Importa impostazioni"

#: includes/Admin/ToolsTab.php:507
msgid ""
"Download all BuddyNext settings as a JSON file, or restore them from a "
"previous export. Only BuddyNext option keys are touched."
msgstr ""
"Scarica tutte le impostazioni di BuddyNext come file JSON, o ripristinale da "
"un'esportazione precedente. Solo i tasti delle opzioni di BuddyNext vengono "
"modificati."

