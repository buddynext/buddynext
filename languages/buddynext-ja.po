#: includes/Admin/Settings.php:3370
#, php-format
msgid "Redirect link (paste this into %s)"
msgstr "リダイレクトリンク（%s に貼り付けてください）"

#. translators: %s: provider name (e.g. Google).
#: includes/Admin/Settings.php:3375
#, php-format
msgid "Copy the redirect link for %s"
msgstr ""

#. translators: %s: provider name (e.g. Google).
#: includes/Admin/Settings.php:3375 includes/Admin/Settings.php:3704
#: includes/Admin/Settings.php:3772 includes/Admin/Settings.php:4094
#: templates/parts/space-settings-panel-invite.php:153
msgid "Copy"
msgstr "コピー"

#. translators: %s: provider name.
#: includes/Admin/Settings.php:3384
#, php-format
msgid "How to get your %s keys"
