#: includes/Core/Installer.php:3784
msgid ""
"<p>Hi {{user_name}},</p><p>Please verify your email address by clicking the "
"link below:</p><p><a href=\"{{verify_url}}\">Verify my email</a></p><p>This "
"link expires in 48 hours.</p>"
msgstr "<p>{{user_name}}さん、こんにちは。</p><p>下のリンクをクリックして、メールアドレスを確認してください。</p><p><a href=\"{{verify_url}}\">メールアドレスを確認する</a></p><p>このリンクの有効期限は48時間です。</p>"

