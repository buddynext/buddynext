#: includes/Admin/Settings.php:2628
msgid "Requires the WPMediaVerse plugin."
msgstr "Vereist de plugin WPMediaVerse."

#: includes/Admin/Settings.php:2631
msgid "This feature is always on and cannot be disabled."
msgstr "Deze functie staat altijd aan en kan niet worden uitgeschakeld."

#: includes/Admin/Settings.php:2653
#. translators: %s: feature label
#, php-format
