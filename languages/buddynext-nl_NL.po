msgstr "Discussie inschakelen"

#: templates/parts/space-settings-panel-integrations.php:235
#: templates/parts/space-settings-panel-integrations.php:238
msgid "Share activity to the main feed"
msgstr "Activiteit delen naar de hoofdfeed"

