msgstr "BuddyNext-instellingen"

#: includes/Admin/Settings.php:2381
msgid "Configure your community platform"
msgstr "Configureer je communityplatform"

#: includes/Admin/Settings.php:2400 includes/Onboarding/SetupWizard.php:164
