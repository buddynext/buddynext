msgstr "Nog geen actieve leden."

#: templates/parts/space-settings-panel-members.php:178
msgid "Remove moderator"
msgstr "Moderator verwijderen"

#: templates/parts/space-settings-panel-members.php:214
msgid "Banned members"
msgstr "Verbannen leden"

#: templates/parts/space-settings-panel-members.php:216
msgid ""
"Members blocked from rejoining this space. Unban to let them request or join "
"again."
msgstr ""
"Leden die niet opnieuw lid kunnen worden van deze ruimte. Hef de ban op "
"zodat ze opnieuw een verzoek kunnen indienen of lid kunnen worden."

#: templates/parts/space-settings-panel-members.php:262
msgid "Invite member"
msgstr "Lid uitnodigen"

#: templates/parts/space-settings-panel-members.php:264
msgid "Enter a member's @handle or an email address to invite them."
msgstr ""
"Voer de @gebruikersnaam van een lid of een e-mailadres in om hen uit te "
"nodigen."

#: templates/parts/space-settings-panel-moderation.php:74
msgid "Control what members can post in this space."
msgstr "Bepaal wat leden in deze ruimte mogen plaatsen."

