# Composer vendor/ is dev/build tooling only (phpcs, phpstan, phpunit) and is
# never shipped. Runtime never touches it: the plugin uses a hand-written PSR-4
# autoloader and bundles its runtime deps (Action Scheduler, EDD SL SDK) under libs/.
/vendor/

# PHPUnit
.phpunit.result.cache
.phpunit.cache/

# macOS
.DS_Store
**/.DS_Store

# IDE
.idea/
.vscode/
*.swp

# Build output
/dist/
/build/

# Local config
.env
wp-tests-config.php

# Brainstorm scratch (legacy mockups regenerated locally, do not track)
/.superpowers/

# Node / Playwright
node_modules/
tests/e2e/_report/
tests/e2e/_results/
playwright/.cache/

# Ad-hoc verification screenshots written into the repo dir by Playwright MCP
# (the server CWD is the symlinked plugin dir). Never commit these.
/a-*.png
/aud-*.png
/mig-*.png
/ux-*.png
/walk-*.png
/mod-reports*.png
/cover-test*.png
/*.playwright-mcp/
/s-*.png
/r-*.png
/icons*.png
/*-screenshot*.png
audit/cert-ledger.json
.cert.json

# flow-audit rebuildable graph cache (regenerated by wppqa flow-audit)
audit/flow.json

# Local test runner output
test-results/

# Internal dev docs + audit live in the private buddynext-pro repo (free-internal/).
# Public repo keeps customer-facing docs (docs/website/) + the public REST API
# catalogue (docs/api/, tracked so release Gate E can git-diff openapi.json). audit/
# stays on disk (gitignored) so local tooling resolves the regenerated manifest +
# flow-audit baseline.
/audit/
/docs/*
!/docs/website/
!/docs/api/

# PHPCS local override. The committed ruleset is phpcs.xml.dist; a tracked
# phpcs.xml silently wins over it (PHPCS prefers the non-.dist name), which is
# exactly how the .dist config sat dead in this repo. Keep local overrides here.
phpcs.xml

# QA working state — internal, never in this PUBLIC repo.
# plan/ holds the Basecamp ledger: the project id, column ids and a full cached
# copy of every card on the board (16MB, 2,597 cards at the 1.2.0 cycle). It is
# untracked by habit today, which is one `git add -A` away from publishing the
# internal board. The canonical copy lives on the Pro shelf with the rest of the
# internal QA material (buddynext-pro/free-internal/).
/plan/

# QA persona bootstrap. Creates local test users with a deterministic password
# convention, so it is dev tooling that should not ship in a public plugin. It
# stays in the working copy because wp-card-qa Step 1 invokes it from here; the
# canonical copy is on the Pro shelf.
/bin/qa-fixtures.sh

# Python bytecode from the QA extractor scripts.
__pycache__/
