<?xml version="1.0"?>
<ruleset name="BuddyNext">
	<description>BuddyNext coding standards — WordPress standard with PSR-4 filename exclusions.</description>

	<!--
		THIS IS THE ONLY RULESET. A tracked phpcs.xml used to sit beside this file
		and silently win: PHP_CodeSniffer prefers phpcs.xml over phpcs.xml.dist, so
		every edit to the .dist was a no-op. The two had drifted into different
		scopes and different excludes, and the .dist half had been dead for as long
		as both existed. phpcs.xml is now gitignored so a local override stays
		possible without shadowing the committed config again.
	-->

	<!--
		Scope = everything that SHIPS, plus committed dev tooling.
		buddynext.php, uninstall.php and blocks/ were missing from the live config
		until 2026-07-21 while all three are on build-release.sh's allowlist, so
		they reached customers without the gate ever reading a line of them.
	-->
	<file>buddynext.php</file>
	<file>uninstall.php</file>
	<file>includes/</file>
	<file>templates/</file>
	<file>blocks/</file>
	<!-- Dev-only tooling (QA fixtures). Never packaged — dev/ is not on
	     build-release.sh's RUNTIME allowlist — but it is committed, so it is held
	     to the same standard as the rest of the tree. -->
	<file>dev/</file>

	<!--
		Tests are OUT of scope, matching buddynext-pro's ruleset. PHPUnit fixtures
		legitimately use patterns the production-path sniffs flag (direct $wpdb
		queries, loose alignment in data providers), and holding them to the
		shipping standard produced 1032 errors across 111 files. That made
		`bin/check.sh` permanently red, so the full gate was never run and the
		SHIPPED violations hid behind the noise — the pre-commit hook only checks
		staged files, so nothing ever surfaced them.

		The trade is deliberate: the gate now covers 100% of what customers
		receive and is green, instead of covering tests too and being ignored.
	-->
	<exclude-pattern>*/tests/*</exclude-pattern>

	<!-- Exclude generated/third-party paths -->
	<exclude-pattern>vendor/</exclude-pattern>
	<exclude-pattern>node_modules/</exclude-pattern>
	<!-- Vendored runtime deps (Action Scheduler, EDD SL SDK) ship verbatim from
	     upstream and are not authored to this ruleset — a dep refresh must not
	     trip the gate, which passes staged paths explicitly. -->
	<exclude-pattern>libs/</exclude-pattern>

	<!-- Base standard -->
	<rule ref="WordPress">
		<!--
		  The project uses PSR-4 autoloading which requires PascalCase filenames
		  (e.g. CommentService.php). WordPress expects class-comment-service.php.
		  PSR-4 takes precedence — suppress the entire file-naming sniff to avoid
		  false positives on every PascalCase file in the codebase.
		-->
		<exclude name="WordPress.Files.FileName"/>

		<!--
		  BuddyNext manages 40 custom bn_* tables with no WP_Query equivalents.
		  Direct $wpdb queries against these tables are intentional and correct;
		  caching is handled per-service via wp_cache_get/set where appropriate.
		  Disabling these sniffs avoids false positives across every service class.
		-->
		<exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
	</rule>

	<!--
		Short array syntax and short ternary (?:) are intentional in this codebase.

		These need severity 0 rather than an <exclude> nested in the WordPress rule
		above: both are PHPCSExtra (Universal.*) sniffs pulled in transitively, so
		excluding them by name inside <rule ref="WordPress"> does not reach them.
		severity 0 disables a sniff no matter which standard loaded it. Verify any
		change here by RUNNING phpcs — the <exclude> form reads correct and does
		nothing, which is how two intentional short ternaries in
		ModerationController sat as reported errors under a config block that
		claimed to allow them.
	-->
	<rule ref="Universal.Arrays.DisallowShortArraySyntax">
		<severity>0</severity>
	</rule>
	<rule ref="Universal.Operators.DisallowShortTernary">
		<severity>0</severity>
	</rule>

	<!-- PHP minimum version -->
	<config name="minimum_supported_wp_version" value="6.9"/>
	<config name="testVersion" value="8.1-"/>
</ruleset>
